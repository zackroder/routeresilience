# ─── Vehicle Source Configuration ───
# Which vehicle data source to use:
#   simulation  (default) — the in-process vehicle simulator
#   gtfs-rt     — poll a real GTFS-RT VehiclePositions feed (CTA)
# Copy this file to `.env` and fill in the GTFS-RT credentials.
# The `.env` file is gitignored — never commit your real API key.
VEHICLE_SOURCE=simulation

# ─── GTFS-RT VehiclePositions (only needed when VEHICLE_SOURCE=gtfs-rt) ───
# CTA GTFS-RT vehicle positions endpoint (base URL, no query params).
GTFS_RT_URL=https://transitdata.transitchicago.com/GtfsRealtime/VehiclePositions.pb
# CTA developer API key (from https://www.transitchicago.com/developers/)
GTFS_RT_API_KEY=
# How often to poll the feed, in milliseconds (default 15000).
GTFS_RT_POLL_INTERVAL_MS=15000
